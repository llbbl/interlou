{
  "name": "interlou",
  "version": "1.0.0",
  "description": "A Micro.blog theme - interlude for your thoughts",
  "author": "Logan Lindquist Land",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npx @tailwindcss/cli -i src/styles.css -o static/css/styles.css --watch",
