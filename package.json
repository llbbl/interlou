{
  "name": "interlou",
  "version": "1.0.0",
  "description": "A Micro.blog theme - interlude for your thoughts",
  "author": "Logan Lindquist Land",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tailwindcss -i src/styles.css -o static/css/styles.css --watch",
    "preview": "bun run ./scripts/preview-server.ts",
    "build": "tailwindcss -i src/styles.css -o static/css/styles.css --minify",
    "gen:fallback": "node scripts/gen-font-fallback.mjs",
    "test": "vitest run",
    "test:hugo": "bun run ./scripts/test-hugo.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "fontaine": "^0.8.0",
    "tailwindcss": "^4.1.18",
    "vitest": "^4.1.11"
  }
}
