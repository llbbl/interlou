    "gen:fallback": "node scripts/gen-font-fallback.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "fontaine": "^0.8.0",
    "tailwindcss": "^4.1.18"
  }
